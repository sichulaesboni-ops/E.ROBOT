// bridge.js - zero external dependencies
const http = require('http');
const { spawn } = require('child_process');
const url = require('url');

const PORT = 8787;
const HOST = '127.0.0.1';

let executor = null;
let state = { connected: false, positions: [], dailyPL: 0, active: false };
let msgId = 0;
const pending = new Map();
const dedupe = new Map();

function startExecutor() {
  executor = spawn('python', ['executor.py'], { stdio: ['pipe', 'pipe', 'pipe'] });
  let buf = '';
  executor.stdout.on('data', d => {
    buf += d.toString();
    const lines = buf.split('\n'); buf = lines.pop();
    for (const l of lines) {
      if (!l.trim()) continue;
      try {
        const m = JSON.parse(l);
        if (m.id && pending.has(m.id)) { pending.get(m.id)(m); pending.delete(m.id); }
        if (m.type === 'state') state = { ...state, ...m.data };
        if (m.type === 'disconnected') state.connected = false;
      } catch (e) { console.error('parse err', e.message); }
    }
  });
  executor.stderr.on('data', d => console.error('exec:', d.toString()));
  executor.on('close', c => { console.log('executor closed', c); executor = null; state.connected = false; });
}

function send(action, payload = {}) {
  return new Promise((resolve, reject) => {
    if (!executor) return reject(new Error('executor down'));
    const id = ++msgId;
    pending.set(id, resolve);
    executor.stdin.write(JSON.stringify({ id, action, payload }) + '\n');
    setTimeout(() => { if (pending.has(id)) { pending.delete(id); reject(new Error('timeout')); } }, 15000);
  });
}

function body(req) {
  return new Promise((res, rej) => {
    let b = ''; req.on('data', c => b += c);
    req.on('end', () => { try { res(b ? JSON.parse(b) : {}); } catch (e) { rej(e); } });
    req.on('error', rej);
  });
}

function json(res, status, obj) {
  res.writeHead(status, {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type'
  });
  res.end(JSON.stringify(obj));
}

const server = http.createServer(async (req, res) => {
  if (req.method === 'OPTIONS') { json(res, 204, {}); return; }
  const p = url.parse(req.url, true).pathname;

  try {
    if (p === '/connect' && req.method === 'POST') {
      const b = await body(req);
      if (!executor) startExecutor();
      try {
        const r = await send('CONNECT', { server: b.server, login: b.login, password: b.password });
        state.connected = !!(r.success);
        return json(res, 200, { status: state.connected ? 'CONNECTED' : 'FAILED', message: r.message || '' });
      } catch (e) {
        return json(res, 503, { error: e.message, status: 'DISCONNECTED' });
      }
    }

    if (p === '/quality' && req.method === 'GET') {
      if (!executor || !state.connected) return json(res, 503, { error: 'not connected' });
      const q = url.parse(req.url, true).query;
      try {
        const r = await send('GET_QUALITY', { symbol: q.symbol || 'XAUUSD', timeframe: q.timeframe || 'H1' });
        return json(res, 200, r.data || { score: 0 });
      } catch (e) { return json(res, 503, { error: e.message }); }
    }

    if (p === '/command' && req.method === 'POST') {
      const b = await body(req);
      if (b.requestId && dedupe.has(b.requestId)) return json(res, 200, dedupe.get(b.requestId));
      if (!executor || !state.connected) return json(res, 503, { error: 'not connected' });
      try {
        const r = await send(b.action, b.payload || {});
        const out = { success: true, data: r.data || r };
        if (b.requestId) { dedupe.set(b.requestId, out); setTimeout(() => dedupe.delete(b.requestId), 60000); }
        return json(res, 200, out);
      } catch (e) { return json(res, 503, { error: e.message }); }
    }

    if (p === '/state' && req.method === 'GET') {
      return json(res, 200, { ...state, executor: !!executor });
    }

    json(res, 404, { error: 'not found' });
  } catch (e) { json(res, 500, { error: e.message }); }
});

server.listen(PORT, HOST, () => {
  console.log(`Bridge on http://${HOST}:${PORT}`);
  startExecutor();
});
process.on('SIGINT', () => { if (executor) executor.kill(); server.close(); process.exit(0); });
