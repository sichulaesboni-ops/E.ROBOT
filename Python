#!/usr/bin/env python3
# executor.py - MT5 Engine (stdin/stdout JSON lines)
import sys, json, math, threading, time

try:
    import MetaTrader5 as mt5
except ImportError:
    mt5 = None

STATE = {"connected": False, "positions": [], "dailyPL": 0.0, "active": False}
LOCK = threading.Lock()
MAX_DAILY_LOSS = 100.0

def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()

def reply(mid, data):
    emit({"id": mid, "data": data})

def do_connect(payload):
    if mt5 is None:
        return {"success": False, "message": "MetaTrader5 package not installed"}
    server = payload.get("server", "")
    login = int(payload.get("login", 0) or 0)
    password = payload.get("password", "")
    ok = mt5.initialize(login=login, server=server, password=password)
    if not ok:
        return {"success": False, "message": f"init failed: {mt5.last_error()}"}
    info = mt5.account_info()
    if info is None:
        return {"success": False, "message": "account_info returned None"}
    with LOCK:
        STATE["connected"] = True
    emit({"type": "state", "data": {"connected": True}})
    return {"success": True, "message": f"Connected to {server}"}

def ema(values, period):
    if len(values) < period: return None
    k = 2.0 / (period + 1)
    e = values[0]
    for v in values[1:]:
        e = v * k + e * (1 - k)
    return e

def calc_quality(symbol, timeframe):
    if mt5 is None or not STATE["connected"]:
        return {"score": 0, "direction": "NEUTRAL", "isStrong": False}
    tf_map = {"M1": mt5.TIMEFRAME_M1, "M5": mt5.TIMEFRAME_M5, "M15": mt5.TIMEFRAME_M15,
              "H1": mt5.TIMEFRAME_H1, "H4": mt5.TIMEFRAME_H4, "D1": mt5.TIMEFRAME_D1}
    tf = tf_map.get(timeframe, mt5.TIMEFRAME_H1)
    rates = mt5.copy_rates_from_pos(symbol, tf, 0, 200)
    if rates is None or len(rates) < 200:
        return {"score": 0, "direction": "NEUTRAL", "isStrong": False}
    closed = rates[:-1]
    closes = [float(r["close"]) for r in closed]
    ema50 = ema(closes[-50:], 50)
    ema200 = ema(closes, 200)
    if ema50 is None or ema200 is None:
        return {"score": 0, "direction": "NEUTRAL", "isStrong": False}
    trend_strength = (ema50 - ema200) / ema200 * 100
    trend_score = min(100, max(0, 50 + trend_strength * 20))
    recent = closes[-10:]
    momentum = (recent[-1] - recent[0]) / recent[0] * 100
    momentum_score = min(100, max(0, 50 + momentum * 30))
    momentum_confirmed = (trend_strength > 0 and momentum > 0) or (trend_strength < 0 and momentum < 0)
    score = round(0.6 * trend_score + 0.4 * momentum_score)
    if not momentum_confirmed:
        score = min(score, 79)
    direction = "BULLISH" if trend_strength > 0 else "BEARISH" if trend_strength < 0 else "NEUTRAL"
    return {"score": score, "direction": direction, "isStrong": score >= 85}

def do_open(payload):
    if mt5 is None or not STATE["connected"]:
        return {"success": False, "error": "not connected"}
    if STATE["dailyPL"] <= -MAX_DAILY_LOSS:
        return {"success": False, "error": "daily loss limit hit"}
    symbol = payload.get("symbol", "XAUUSD")
    lot = float(payload.get("lot", 0.05))
    direction = payload.get("direction", "BULLISH")
    order_type = mt5.ORDER_TYPE_BUY if direction == "BULLISH" else mt5.ORDER_TYPE_SELL
    tick = mt5.symbol_info_tick(symbol)
    info = mt5.symbol_info(symbol)
    if tick is None or info is None:
        return {"success": False, "error": "symbol info unavailable"}
    price = tick.ask if order_type == mt5.ORDER_TYPE_BUY else tick.bid
    stops_level = info.trade_stops_level * info.point
    sl = price - stops_level * 1.5 if order_type == mt5.ORDER_TYPE_BUY else price + stops_level * 1.5
    tp = price + stops_level * 3.0 if order_type == mt5.ORDER_TYPE_BUY else price - stops_level * 3.0
    req = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": lot,
        "type": order_type,
        "price": price,
        "sl": sl,
        "tp": tp,
        "deviation": 20,
        "magic": 123456,
        "comment": "E.ROBOT",
        "type_time": mt5.ORDER_TIME_GTC,
        "type_filling": mt5.ORDER_FILLING_IOC,
    }
    res = mt5.order_send(req)
    if res is None or res.retcode != mt5.TRADE_RETCODE_DONE:
        return {"success": False, "error": str(res.retcode if res else "None")}
    return {"success": True, "ticket": res.order, "price": price}

def do_close_all():
    if mt5 is None or not STATE["connected"]:
        return {"success": False, "error": "not connected"}
    positions = mt5.positions_get()
    closed = 0
    if positions:
        for p in positions:
            if p.magic != 123456: continue
            tick = mt5.symbol_info_tick(p.symbol)
            if tick is None: continue
            close_type = mt5.ORDER_TYPE_SELL if p.type == mt5.POSITION_TYPE_BUY else mt5.ORDER_TYPE_BUY
            price = tick.bid if close_type == mt5.ORDER_TYPE_SELL else tick.ask
            req = {
                "action": mt5.TRADE_ACTION_DEAL,
                "position": p.ticket,
                "symbol": p.symbol,
                "volume": p.volume,
                "type": close_type,
                "price": price,
                "deviation": 20,
                "magic": 123456,
                "comment": "E.ROBOT CLOSE",
                "type_time": mt5.ORDER_TIME_GTC,
                "type_filling": mt5.ORDER_FILLING_IOC,
            }
            r = mt5.order_send(req)
            if r and r.retcode == mt5.TRADE_RETCODE_DONE: closed += 1
    orders = mt5.orders_get()
    if orders:
        for o in orders:
            if o.magic != 123456: continue
            mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
    return {"success": True, "closed": closed}

def handle(msg):
    mid = msg.get("id")
    action = msg.get("action", "").upper()
    payload = msg.get("payload", {}) or {}
    try:
        if action == "CONNECT":
            reply(mid, do_connect(payload))
        elif action == "GET_QUALITY":
            reply(mid, calc_quality(payload.get("symbol", "XAUUSD"), payload.get("timeframe", "H1")))
        elif action == "OPEN":
            reply(mid, do_open(payload))
        elif action == "CLOSE_ALL":
            reply(mid, do_close_all())
        elif action == "START":
            with LOCK: STATE["active"] = True
            reply(mid, {"success": True})
        elif action == "STOP":
            with LOCK: STATE["active"] = False
            reply(mid, {"success": True})
        else:
            reply(mid, {"success": False, "error": f"unknown action {action}"})
    except Exception as e:
        reply(mid, {"success": False, "error": str(e)})

def main():
    for line in sys.stdin:
        line = line.strip()
        if not line: continue
        try:
            msg = json.loads(line)
        except Exception:
            continue
        t = threading.Thread(target=handle, args=(msg,), daemon=True)
        t.start()

if __name__ == "__main__":
    main()
